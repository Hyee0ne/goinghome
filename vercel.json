{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/animal-photo/:path*", "destination": "https://openapi.animal.go.kr/openapi/service/rest/fileDownloadSrvc/files/:path*" }
  ],
  "redirects": [
    { "source": "/make", "destination": "/find", "permanent": false }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
